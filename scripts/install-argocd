#!/usr/bin/env bash

set -euo pipefail

ARGOCD_NAMESPACE="argocd"
ARGOCD_HELM_RELEASE="argo-cd"
# Extract version from Chart.yaml dependencies
ARGOCD_CHART_VERSION=$(yq '.dependencies[] | select(.name == "argo-cd") | .version' kubernetes/charts/core-services/argo-cd/Chart.yaml | tr -d '"')

# Environment
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SOPS_KEY_PATH="$REPO_ROOT/.sops-age.key"

cd "$REPO_ROOT"

echo "🚀 Installing Argo CD ${ARGOCD_CHART_VERSION} via Helm..."

# Create the namespace if it doesn't exist
kubectl create namespace "${ARGOCD_NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

# Bootstrap repository credentials if the repository is private
if ! kubectl get secret github-repo-creds -n "${ARGOCD_NAMESPACE}" &>/dev/null; then
  echo "🔑 Repository credentials secret 'github-repo-creds' not found."
  SEALED_SECRET_PATH="kubernetes/charts/core-services/argo-cd/templates/github-repo-creds.yaml"

  if [ -f "$SEALED_SECRET_PATH" ]; then
    echo "🔓 Decrypting credentials offline using SOPS and kubeseal..."
    TEMP_KEY_FILE=".decrypted-key-temp.yaml"

    # Decrypt the sealed secrets key
    sops --decrypt sealed-secrets-key.sops.yaml >"$TEMP_KEY_FILE"

    # Decrypt the SealedSecret directly into the cluster
    kubeseal --recovery-unseal --recovery-private-key "$TEMP_KEY_FILE" <"$SEALED_SECRET_PATH" | kubectl apply -f -

    # Clean up the temporary key file immediately
    rm -f "$TEMP_KEY_FILE"

    echo "✅ Successfully bootstrapped 'github-repo-creds' from SealedSecret!"
  else
    echo "⚠️  SealedSecret file not found at ${SEALED_SECRET_PATH}."
    echo "If this is a private repository, please create the credential secret manually or configure the SealedSecret."
  fi
fi

# Install ArgoCD via Helm using the same release name the self-managed app expects.
# This prevents a duplicate install when ArgoCD takes over its own management.
# yq is used to extract the 'argo-cd' sub-key because the parent chart's values.yaml
# structure puts Argo CD's own configuration under that key.
helm upgrade --install "${ARGOCD_HELM_RELEASE}" argo-cd \
  --repo https://argoproj.github.io/argo-helm \
  --version "${ARGOCD_CHART_VERSION}" \
  --namespace "${ARGOCD_NAMESPACE}" \
  --values <(yq '."argo-cd"' kubernetes/charts/core-services/argo-cd/values.yaml) \
  --wait

echo "✅ Argo CD is installed!"

echo "🌱 Applying Root Application (App of Apps)..."
helm template kubernetes/root-app | kubectl apply -f -

echo "🎉 Setup complete! You can access the Argo CD UI via port-forward:"
echo "   kubectl port-forward svc/argo-cd-argocd-server -n argocd 8080:443"
