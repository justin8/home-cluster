#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: $(basename "$0") <secret-name> [-n <namespace>]"
    echo "       $(basename "$0") -n <namespace>"
    echo ""
    echo "Fetch and decode base64 values from Kubernetes Secrets."
    echo ""
    echo "Options:"
    echo "  -n, --namespace <ns>   Namespace to fetch secret(s) from"
    echo "  -h, --help             Show this help message"
    echo ""
    echo "Examples:"
    echo "  $(basename "$0") uhf-secrets -n uhf"
    echo "  $(basename "$0") -n downloads"
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
    exit 0
fi

kubectl get secret "$@" -o json \
  | jq -r '
    if .kind == "List" then
      .items[] | .metadata.name as $name | .data // {} | to_entries[] | "\($name) \(.key): \(.value | @base64d)"
    else
      .data // {} | to_entries[] | "\(.key): \(.value | @base64d)"
    end'
